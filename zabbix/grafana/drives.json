              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Host IO psi"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "#FCCB1D",
                      "value": 10
                    },
                    {
                      "color": "#E65660",
                      "value": 25
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Host": 0,
              "Serial": 1,
              "Size": 2,
              "Media": 3,
              "Used": 4,
              "Busy": 5,
              "Wait": 6,
              "Queue": 7,
              "Read": 8,
              "Write": 9,
              "Host IO psi": 10
            },
            "excludeByName": {},
