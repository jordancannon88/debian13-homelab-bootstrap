{
  "uid": "homelab-drives",
  "title": "Drives",
  "description": "One row per physical drive, from the Zabbix Homelab drives template through the Infinity data source (Kan bfrdv9wpggve). Source of truth: zabbix/grafana/drives.json in debian13-homelab-bootstrap.",
  "tags": [
    "homelab",
    "zabbix",
    "drives"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Drives: activity",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "http://zabbix.internal.cannon.dev/api_jsonrpc.php",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"jsonrpc\": \"2.0\", \"method\": \"item.get\", \"id\": 1, \"params\": {\"output\": [\"name\", \"key_\", \"lastvalue\", \"units\"], \"selectHosts\": [\"host\"], \"selectTags\": \"extend\", \"monitored\": true, \"filter\": {\"status\": \"0\"}, \"tags\": [{\"tag\": \"fact\", \"operator\": \"4\"}]}}"
          },
          "root_selector": "$sort(\n  $each(result{tags[tag=\"drive\"].value: $}, function($items, $drive) {\n    $merge([{\"drive\": $drive, \"host\": $items[0].hosts[0].host},\n            $items{tags[tag=\"fact\"].value: lastvalue}])\n  }),\n  function($a, $b) { ($a.host & \"|\" & $a.serial) > ($b.host & \"|\" & $b.serial) }\n)",
          "columns": [
            {
              "selector": "host",
              "text": "Host",
              "type": "string"
            },
            {
              "selector": "serial",
              "text": "Serial",
              "type": "string"
            },
            {
              "selector": "size",
              "text": "Size",
              "type": "number"
            },
            {
              "selector": "media",
              "text": "Media",
              "type": "string"
            },
            {
              "selector": "used",
              "text": "Used",
              "type": "number"
            },
            {
              "selector": "busy",
              "text": "Busy",
              "type": "number"
            },
            {
              "selector": "wait",
              "text": "Wait",
              "type": "number"
            },
            {
              "selector": "queue",
              "text": "Queue",
              "type": "number"
            },
            {
              "selector": "read",
              "text": "Read",
              "type": "number"
            },
            {
              "selector": "write",
              "text": "Write",
              "type": "number"
            },
            {
              "selector": "host_io_psi",
              "text": "Host IO psi",
              "type": "number"
            }
          ]
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "\u2014",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": [
